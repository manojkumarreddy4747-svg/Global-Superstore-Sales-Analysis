--- Find top 10 products by sales

SELECT TOP 10
    P.Product_ID,
    P.Product_Name,
    P.Category,
    P.Sub_Category,
    SUM(S.Sales) AS Total_Sales
FROM dbo.Sales AS S
INNER JOIN dbo.Products AS P
    ON S.ProductKey = P.ProductKey
GROUP BY
    P.Product_ID,
    P.Product_Name,
    P.Category,
    P.Sub_Category
ORDER BY Total_Sales DESC;


--- Find category-wise sales and profit

SELECT
    P.Category,
    SUM(S.Sales) AS Total_Sales,
    SUM(S.Profit) AS Total_Profit,
    SUM(S.Quantity) AS Total_Quantity
FROM dbo.Sales AS S
INNER JOIN dbo.Products AS P
    ON S.ProductKey = P.ProductKey
GROUP BY P.Category
ORDER BY Total_Sales DESC;


--- Find subcategories generating losses

SELECT
    P.Sub_Category,
    SUM(S.Sales) AS Total_Sales,
    SUM(S.Profit) AS Total_Profit
FROM dbo.Sales AS S
INNER JOIN dbo.Products AS P
    ON S.ProductKey = P.ProductKey
GROUP BY P.Sub_Category
HAVING SUM(S.Profit) < 0
ORDER BY Total_Profit;
